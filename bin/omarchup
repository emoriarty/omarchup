#!/usr/bin/env bash
# ==============================================================================
# Omarchup - Personal Add-on & Dotfiles Layer for Omarchy OS
# ==============================================================================

set -euo pipefail

# Resolve symlinks to find repository root directory
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
SCRIPT_DIR="$( cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd )"

# Source configurations and modules
# shellcheck source=../config/packages.conf
source "${SCRIPT_DIR}/config/packages.conf"
# shellcheck source=../config/dotfiles.conf
source "${SCRIPT_DIR}/config/dotfiles.conf"
# shellcheck source=../config/aliases.conf
source "${SCRIPT_DIR}/config/aliases.conf"
# shellcheck source=../lib/ui.sh
source "${SCRIPT_DIR}/lib/ui.sh"
# shellcheck source=../lib/packages.sh
source "${SCRIPT_DIR}/lib/packages.sh"
# shellcheck source=../lib/dotfiles.sh
source "${SCRIPT_DIR}/lib/dotfiles.sh"
# shellcheck source=../lib/tmux.sh
source "${SCRIPT_DIR}/lib/tmux.sh"
# shellcheck source=../lib/vlc.sh
source "${SCRIPT_DIR}/lib/vlc.sh"
# shellcheck source=../lib/aliases.sh
source "${SCRIPT_DIR}/lib/aliases.sh"
# shellcheck source=../lib/hyprland.sh
source "${SCRIPT_DIR}/lib/hyprland.sh"

show_help() {
  print_logo
  echo -e "${CLR_BOLD}Usage:${CLR_RESET}"
  echo -e "  omarchup [command] [options]\n"
  echo -e "${CLR_BOLD}Commands:${CLR_RESET}"
  echo -e "  ${CLR_GREEN}sync${CLR_RESET} [default]     Install packages, sync dotfiles, configure tmux, VLC, aliases & Hyprland"
  echo -e "  ${CLR_GREEN}packages${CLR_RESET} [action]  Manage packages (actions: sync, status)"
  echo -e "  ${CLR_GREEN}dotfiles${CLR_RESET} [action]  Manage dotfiles (actions: sync, status, --force)"
  echo -e "  ${CLR_GREEN}tmux${CLR_RESET} [action]      Manage Omarchy tmux configuration (actions: sync, status)"
  echo -e "  ${CLR_GREEN}vlc${CLR_RESET} [action]       Manage VLC UPnP configuration & status"
  echo -e "  ${CLR_GREEN}aliases${CLR_RESET} [action]   Manage personal shell aliases (actions: sync, status)"
  echo -e "  ${CLR_GREEN}hyprland${CLR_RESET} [action]  Manage Hyprland configuration (actions: sync, status)"
  echo -e "  ${CLR_GREEN}status${CLR_RESET}             Display overall system status"
  echo -e "  ${CLR_GREEN}help${CLR_RESET}               Show this help message\n"
  echo -e "${CLR_BOLD}Global Options:${CLR_RESET}"
  echo -e "  ${CLR_CYAN}-q, --quiet${CLR_RESET}        Suppress logo and decorative banners\n"
  echo -e "${CLR_BOLD}Examples:${CLR_RESET}"
  echo -e "  omarchup                   # Runs complete sync"
  echo -e "  omarchup status            # Inspect current status of all managed parts"
  echo -e "  omarchup aliases sync      # Synchronizes personal shell aliases"
  echo -e "  omarchup hyprland sync     # Configures Caps Lock to Ctrl remap in Hyprland"
  echo -e "  omarchup vlc sync          # Configures UPnP discovery for VLC"
}

cmd_sync() {
  print_logo
  sync_packages
  sync_dotfiles false
  sync_tmux
  sync_vlc
  sync_aliases
  sync_hyprland
  echo
  log_success "Omarchup synchronization complete!"
}

cmd_status() {
  print_logo
  status_packages
  status_dotfiles
  status_tmux
  status_vlc
  status_aliases
  status_hyprland
}

cmd_packages() {
  local sub="${1:-sync}"
  case "$sub" in
    sync)
      print_logo
      sync_packages
      ;;
    status)
      status_packages
      ;;
    *)
      log_error "Unknown packages action: $sub"
      echo "Valid actions: sync, status"
      exit 1
      ;;
  esac
}

cmd_dotfiles() {
  local sub="${1:-sync}"
  local force=false

  for arg in "$@"; do
    if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
      force=true
    fi
  done

  case "$sub" in
    sync|--force|-f)
      print_logo
      sync_dotfiles "$force"
      ;;
    status)
      status_dotfiles
      ;;
    *)
      log_error "Unknown dotfiles action: $sub"
      echo "Valid actions: sync, status, --force"
      exit 1
      ;;
  esac
}

cmd_tmux() {
  local sub="${1:-sync}"
  case "$sub" in
    sync)
      print_logo
      sync_tmux
      ;;
    status)
      status_tmux
      ;;
    *)
      log_error "Unknown tmux action: $sub"
      echo "Valid actions: sync, status"
      exit 1
      ;;
  esac
}

cmd_vlc() {
  local sub="${1:-sync}"
  case "$sub" in
    sync)
      print_logo
      sync_vlc
      ;;
    status)
      status_vlc
      ;;
    *)
      log_error "Unknown vlc action: $sub"
      echo "Valid actions: sync, status"
      exit 1
      ;;
  esac
}

cmd_aliases() {
  local sub="${1:-sync}"
  case "$sub" in
    sync)
      print_logo
      sync_aliases
      ;;
    status)
      status_aliases
      ;;
    *)
      log_error "Unknown aliases action: $sub"
      echo "Valid actions: sync, status"
      exit 1
      ;;
  esac
}

cmd_hyprland() {
  local sub="${1:-sync}"
  case "$sub" in
    sync)
      print_logo
      sync_hyprland
      ;;
    status)
      status_hyprland
      ;;
    *)
      log_error "Unknown hyprland action: $sub"
      echo "Valid actions: sync, status"
      exit 1
      ;;
  esac
}

main() {
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "--quiet" || "$arg" == "-q" ]]; then
      export OMARCHUP_QUIET=1
    else
      filtered_args+=("$arg")
    fi
  done

  local cmd="${filtered_args[0]:-sync}"
  local rest_args=()
  if ((${#filtered_args[@]} > 1)); then
    rest_args=("${filtered_args[@]:1}")
  fi

  case "$cmd" in
    sync)
      cmd_sync "${rest_args[@]}"
      ;;
    packages|pkg)
      cmd_packages "${rest_args[@]}"
      ;;
    dotfiles|dot)
      cmd_dotfiles "${rest_args[@]}"
      ;;
    tmux)
      cmd_tmux "${rest_args[@]}"
      ;;
    vlc)
      cmd_vlc "${rest_args[@]}"
      ;;
    aliases|alias)
      cmd_aliases "${rest_args[@]}"
      ;;
    hyprland|hypr|keyboard|input)
      cmd_hyprland "${rest_args[@]}"
      ;;
    status)
      cmd_status
      ;;
    help|--help|-h)
      show_help
      ;;
    *)
      log_error "Unknown command: $cmd"
      echo "Run 'omarchup help' for usage instructions."
      exit 1
      ;;
  esac
}

main "$@"
